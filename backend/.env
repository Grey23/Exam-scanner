# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=exam_scanner

# Server Configuration
PORT=3000
# GOOGLE_APPLICATION_CREDENTIALS=C:\xampp\htdocs\capstone\backend\service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# JWT Secret
JWT_SECRET=your-secret-key-change-this-in-production

# Node Environment
NODE_ENV=development

# Firebase Admin (for admin-only operations like setting user passwords)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
